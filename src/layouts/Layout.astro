---
interface Props {
  title?: string;
}

const { title = 'Bachata Clip Slicer' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { height: 100%; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0a0a0a; color: #e0e0e0; }
      header { display: flex; align-items: center; justify-content: space-between; padding: 8px 16px; background: #111; border-bottom: 1px solid #222; }
      header h1 { font-size: 1rem; font-weight: 600; color: #e0e0e0; }
      header .manifest { font-size: 0.75rem; color: #888; }
      main { height: calc(100vh - 41px); overflow: hidden; }
    </style>
  </head>
  <body>
    <header>
      <h1>🎵 Bachata Clip Slicer</h1>
      <div class="manifest" id="manifest-summary"></div>
    </header>
    <main>
      <slot />
    </main>
    <script>
      async function loadManifest() {
        try {
          const res = await fetch('/api/project');
          if (!res.ok) return;
          const data = await res.json();
          const el = document.getElementById('manifest-summary');
          if (el && data) {
            el.textContent = `${data.sources_count ?? 0} source(s) · ${data.clips_total ?? 0} clip(s) · ${Math.round((data.annotation_completeness ?? 0) * 100)}% complete`;
          }
        } catch { /* ignore */ }
      }
      loadManifest();
    </script>
  </body>
</html>
