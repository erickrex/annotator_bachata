  "reason_code_definitions": {
    "state_match": "The source exit state directly matches the target entry state.",
    "phrase_safe": "The pair can resolve cleanly at a normalized eight-count boundary.",
    "energy_build": "The target raises movement or visual energy.",
    "energy_release": "The target lowers energy or creates a reset.",
    "hand_change": "A short, explicit hand-connection change is required.",
    "position_change": "A short spatial repositioning is required.",
    "camera_continuity": "The pair has compatible default framing requirements.",
    "accent_ready": "The target offers a clear musical-accent opportunity.",
    "terminal": "The target is designed to end a phrase or scene."
  },
