# ---------------------------------------------------------------------------
# AdaptiveLabel environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env*` files are gitignored; never commit secrets.
# ---------------------------------------------------------------------------

# Aurora PostgreSQL (pgvector enabled) connection string.
# Use a pooled / serverless-safe endpoint (e.g. RDS Proxy or a pooler) in prod.
# Requirement 7.2 / 7.3 / 7.5
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/adaptive_label?sslmode=require"

# AI provider key for the Vercel AI SDK (schema generation, pre-labeling,
# and offline embedding generation). Requirement 7.5 / 1.1 / 5.2
OPENAI_API_KEY=""

# Embedding model + dimension. Must match the clips.embedding vector(N) column.
# Requirement 5.6
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_EMBEDDING_DIMENSIONS="1536"

# Object storage for demo media clips (IP-clean). Requirement 7.5 / 8.5
# Base public URL that static/demo clips are served from.
STORAGE_PUBLIC_BASE_URL=""
# Optional storage credentials/bucket (only if using a managed object store).
STORAGE_BUCKET=""
STORAGE_REGION=""

# Runtime media processing (self-hosted Next.js runtime, not Vercel serverless).
# ffmpeg and ffprobe must be available on PATH; Python tools run through uv.
ADAPTIVE_LABEL_MEDIA_DIR=".media"
MEDIA_PROCESSING_MODE="in_process"
